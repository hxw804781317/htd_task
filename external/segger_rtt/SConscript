import os
from building import *

# get current dir path
cwd = GetCurrentDir()
objs = []

# init src and inc vars
src = []
inc = [cwd]
src += Glob('./SEGGER_RTT.c')
src += Glob('./SEGGER_RTT_printf.c')
objs = DefineGroup('htd_external', src, depend = ['HTD_LIB_USE_SEGGER_RTT'], CPPPATH = inc, LOCAL_CCFLAGS = '')

list = os.listdir(cwd)
for d in list:
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        objs = objs + SConscript(os.path.join(d, 'SConscript'))              
Return('objs')
