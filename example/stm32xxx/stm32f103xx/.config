CONFIG_SOC_FAMILY_STM32=y
CONFIG_SOC_SERIES_STM32F1=y
CONFIG_SOC_SERIES_STM32F103XX=y
CONFIG_SOC_STM32F103XB=y

#
# HTD-TASK
#
CONFIG_HTD_TASK_ENABLE=y
CONFIG_HTD_TASK_NONOS=y
# CONFIG_HTD_TASK_FREERTOS is not set
CONFIG_HTD_MEMHEAP_FF_ENABLE=y
CONFIG_HTD_MEMHEAP_SRAM_DEV_COUNT=2
# CONFIG_HTD_MEMHEAP_FF_USE_TRACE is not set
# CONFIG_HTD_PRINTF_SUPPORT_FLOAT is not set
# CONFIG_HTD_MEM_USE_BYTELOOP is not set
# CONFIG_HTD_VER_RELEASE is not set
# end of HTD-TASK

CONFIG_ARCH_ARM=y
CONFIG_ARCH_ARM_CORTEX_M=y
CONFIG_ARCH_ARM_CORTEX_M3=y

#
# components config
#
CONFIG_HTD_CONSOLE_ENABLE=y
CONFIG_HTD_CONSOLE_NAME="htd"
CONFIG_HTD_CONSOLE_SUPPORT_CMD=y
CONFIG_HTD_CONSOLE_SUPPORT_CMD_HISTORY=y
CONFIG_HTD_CONSOLE_HISTORY_LINES=5
CONFIG_HTD_CONSOLE_CMD_SIZE=48
CONFIG_HTD_CONSOLE_SERIAL_NAME="segger_rtt"
CONFIG_HTD_CONSOLE_SERIAL_TX_PINNUM=0x09
CONFIG_HTD_CONSOLE_SERIAL_RX_PINNUM=0x0A
CONFIG_HTD_CONSOLE_SERIAL_BAUDRATE=115200
CONFIG_HTD_BUTTON_ENABLE=y
CONFIG_HTD_BUTTON_SUPPORT_MATRIX=y
CONFIG_BUTTON_MATRIX_SUPPORT_REPEAT=y
# CONFIG_HTD_BUTTON_SUPPORT_CHARLIE is not set
CONFIG_HTD_LED_ENABLE=y
CONFIG_HTD_LED_SUPPORT_CHARLIE=y
# CONFIG_HTD_LED_SUPPORT_MATRIX is not set
CONFIG_HTD_LED_USE_HW_TIMER=y
CONFIG_HTD_LED_HW_TIMER_NAME="timer1"
# end of components config

#
# components config
#
# CONFIG_HTD_LIB_USE_EASYTLV is not set
# CONFIG_HTD_LIB_USE_MICRO_ECC is not set
# CONFIG_HTD_LIB_USE_SDL2 is not set
CONFIG_HTD_LIB_USE_SEGGER_RTT=y
# CONFIG_HTD_LIB_USE_FREERTOS is not set
# end of components config

#
# On-chip Peripheral Drivers
#
CONFIG_BSP_USING_UART=y
# CONFIG_BSP_USING_UART1 is not set
# CONFIG_BSP_USING_UART2 is not set
# CONFIG_BSP_USING_UART3 is not set
# CONFIG_BSP_USING_SPIM is not set
# CONFIG_BSP_USING_I2CM is not set
# CONFIG_BSP_USING_SDIO is not set
# CONFIG_BSP_USING_ADC is not set
CONFIG_BSP_USING_RTC=y
# CONFIG_BSP_USING_WDT is not set
CONFIG_BSP_USING_PM=y
CONFIG_BSP_USING_CRC=y
# CONFIG_BSP_USING_USB_DEVICE is not set
# CONFIG_BSP_USING_TIM_PWM_OCC is not set
# end of On-chip Peripheral Drivers
