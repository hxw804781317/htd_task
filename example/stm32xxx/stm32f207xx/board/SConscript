from building import *
import os

cwd = GetCurrentDir()
src = []
CPPPATH = [cwd]

# STM32F205xx 
# STM32F207xx
# STM32F215xx 
# STM32F217xx
CPPDEFINES = ['STM32F207xx']

src = Glob('*.c')
src += Glob('startup_stm32f207xx.s');

group = DefineGroup('stm32f207', src, depend = [''], CPPPATH = CPPPATH, CPPDEFINES = CPPDEFINES)
list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))
Return('group')
