CONFIG_SOC_FAMILY_STM32=y
CONFIG_SOC_SERIES_STM32F4=y
CONFIG_SOC_SERIES_STM32F411XX=y
CONFIG_SOC_STM32F411xE=y

#
# HTD-TASK
#
CONFIG_HTD_TASK_ENABLE=y
CONFIG_HTD_TASK_NONOS=y
# CONFIG_HTD_TASK_FREERTOS is not set
CONFIG_HTD_MEMHEAP_FF_ENABLE=y
CONFIG_HTD_MEMHEAP_SRAM_DEV_COUNT=2
# CONFIG_HTD_MEMHEAP_FF_USE_TRACE is not set
# CONFIG_HTD_PRINTF_SUPPORT_FLOAT is not set
# CONFIG_HTD_MEM_USE_BYTELOOP is not set
# CONFIG_HTD_VER_RELEASE is not set
# end of HTD-TASK

CONFIG_ARCH_ARM=y
CONFIG_ARCH_ARM_CORTEX_M=y
CONFIG_ARCH_ARM_CORTEX_FPU=y
CONFIG_ARCH_ARM_CORTEX_M4=y

#
# components config
#
# CONFIG_HTD_BOOT_ENABLE is not set
CONFIG_HTD_CONSOLE_ENABLE=y
CONFIG_HTD_CONSOLE_NAME="htd"
CONFIG_HTD_CONSOLE_SUPPORT_CMD=y
CONFIG_HTD_CONSOLE_SUPPORT_CMD_HISTORY=y
CONFIG_HTD_CONSOLE_HISTORY_LINES=5
CONFIG_HTD_CONSOLE_CMD_SIZE=48
CONFIG_HTD_CONSOLE_SERIAL_NAME="segger_rtt"
CONFIG_HTD_CONSOLE_SERIAL_TX_PINNUM=0x09
CONFIG_HTD_CONSOLE_SERIAL_RX_PINNUM=0x0A
CONFIG_HTD_CONSOLE_SERIAL_BAUDRATE=115200
CONFIG_HTD_BUTTON_ENABLE=y
CONFIG_HTD_BUTTON_SUPPORT_MATRIX=y
CONFIG_BUTTON_MATRIX_SUPPORT_REPEAT=y
CONFIG_HTD_BUTTON_SUPPORT_CHARLIE=y
CONFIG_BUTTON_CHARLIE_SUPPORT_REPEAT=y
CONFIG_HTD_LED_ENABLE=y
# CONFIG_HTD_LED_SUPPORT_CHARLIE is not set
# CONFIG_HTD_LED_SUPPORT_MATRIX is not set
# CONFIG_HTD_LED_USE_HW_TIMER is not set
# CONFIG_HTD_FLASH_UTILITY_BOX_ENABLE is not set
CONFIG_HTD_VFS_ENABLE=y
# CONFIG_HTD_VFS_USING_NORFLASH_DEV is not set
# CONFIG_HTD_VFS_USING_NANDFLASH_DEV is not set
# CONFIG_HTD_VFS_USING_SDCARD_DEV is not set
CONFIG_HTD_VFS_USING_POSIX=y
CONFIG_HTD_VFS_FD_MAX=16
# CONFIG_HTD_VFS_USING_ROMFS is not set
# CONFIG_HTD_VFS_USING_RAMFS is not set
# CONFIG_HTD_VFS_USING_SPIFFS is not set
# CONFIG_HTD_VFS_USING_ELM_FATFS is not set
# CONFIG_HTD_VFS_USING_LITTLE_FS is not set
CONFIG_HTD_ELFDL_ENABLE=y
CONFIG_ELFDL_LOAD_IN_SIMULATE=y
# CONFIG_ELFDL_LOAD_IN_RAM is not set
# CONFIG_ELFDL_LOAD_IN_XIP is not set
# end of components config

#
# Hardware Drivers Config
#
# CONFIG_HTD_USING_NANDFLASH is not set
# CONFIG_HTD_USING_NORFLASH is not set
# CONFIG_HTD_USING_EEPROM is not set
# CONFIG_HTD_SENSOR_USING_BAROMETER is not set
# CONFIG_HTD_SENSOR_USING_GSENSOR is not set
# CONFIG_HTD_SENSOR_USING_6AXIS is not set
# CONFIG_HTD_USING_PIXEL_LED is not set
# CONFIG_HTD_USING_SDCARD is not set
# CONFIG_HTD_USING_NETWORK_SENSOR is not set
# end of Hardware Drivers Config

#
# external config
#
# CONFIG_HTD_LIB_USE_EASYTLV is not set
# CONFIG_HTD_LIB_USE_MICRO_ECC is not set
# CONFIG_HTD_LIB_USE_QUICKLZ is not set
# CONFIG_HTD_LIB_USE_FASTLZ is not set
# CONFIG_HTD_LIB_USE_SDL2 is not set
CONFIG_HTD_LIB_USE_SEGGER_RTT=y
# CONFIG_HTD_LIB_USE_FREERTOS is not set
# end of external config

#
# On-chip Peripheral Drivers
#
CONFIG_BSP_USING_UART=y
CONFIG_BSP_USING_UART1=y
CONFIG_BSP_UART1_RX_USING_DMA=y
CONFIG_BSP_UART1_TX_USING_DMA=y
# CONFIG_BSP_USING_UART2 is not set
# CONFIG_BSP_USING_UART3 is not set
# CONFIG_BSP_USING_UART4 is not set
# CONFIG_BSP_USING_UART5 is not set
# CONFIG_BSP_USING_UART6 is not set
CONFIG_BSP_USING_SPIM=y
CONFIG_BSP_USING_SPIM1=y
CONFIG_BSP_SPIM1_USING_DMA=y
# CONFIG_BSP_USING_SPIM2 is not set
# CONFIG_BSP_USING_SPIM3 is not set
# CONFIG_BSP_USING_SPIM4 is not set
# CONFIG_BSP_USING_SPIM5 is not set
CONFIG_BSP_USING_SFW_SPIM1=y
CONFIG_BSP_USING_SFW_SPIM2=y
# CONFIG_BSP_USING_SFW_SPIM3 is not set
# CONFIG_BSP_USING_SFW_SPIM4 is not set
# CONFIG_BSP_USING_SFW_SPIM5 is not set
CONFIG_BSP_USING_I2CM=y
CONFIG_BSP_USING_I2CM1=y
# CONFIG_BSP_USING_I2CM2 is not set
# CONFIG_BSP_USING_I2CM3 is not set
CONFIG_BSP_USING_SFW_I2CM1=y
# CONFIG_BSP_USING_SFW_I2CM2 is not set
# CONFIG_BSP_USING_SFW_I2CM3 is not set
# CONFIG_BSP_USING_SDIO is not set
# CONFIG_BSP_USING_ADC is not set
CONFIG_BSP_USING_RTC=y
# CONFIG_BSP_USING_WDT is not set
CONFIG_BSP_USING_PM=y
CONFIG_BSP_USING_CRC=y
# CONFIG_BSP_USING_USB_DEVICE is not set
# CONFIG_BSP_USING_USB_HOST is not set
# CONFIG_BSP_USING_TIM_PWM_OCC is not set
# end of On-chip Peripheral Drivers
