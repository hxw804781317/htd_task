from building import *
import os

cwd = GetCurrentDir()
src = []
CPPPATH = [cwd]

# STM32F401xB | STM32F401xC | STM32F401xD | STM32F401xE
# STM32F405xE | STM32F405xG
# STM32F407xE | STM32F407xG
# STM32F410x8 | STM32F410xB 
# STM32F411xC | STM32F411xE  
# STM32F412xE | STM32F412xG
# STM32F413xG | STM32F413xH
# STM32F415xG
# STM32F417xE | STM32F417xG
# STM32F423xH
# STM32F427xG | STM32F427xI
# STM32F429xE | STM32F429xG | STM32F429xI
# STM32F437xG | STM32F437xI
# STM32F439xG | STM32F439xI
# STM32F446xC | STM32F446xE
# STM32F469xE | STM32F469xG | STM32F469xI
# STM32F479xG | STM32F479xI
CPPDEFINES = ['STM32F401xC']

src = Glob('*.c')
src += Glob('startup_stm32f401xc.s');

group = DefineGroup('stm32f4xx', src, depend = [''], CPPPATH = CPPPATH, CPPDEFINES = CPPDEFINES)
list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))
Return('group')
