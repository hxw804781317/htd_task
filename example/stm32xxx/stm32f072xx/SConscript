# 开发板资料地址：https://gitee.com/WeAct-TC/WeActStudio.MiniSTM32F4x1
# for module compiling
from building import *
import os

cwd = GetCurrentDir()
objs = []

# 包含指定头文件
src = []
inc = [cwd]
src += Glob('/*.c')
objs = DefineGroup('Applications', src, depend = [''], CPPPATH = inc)

list = os.listdir(cwd)
for d in list:
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        objs = objs + SConscript(os.path.join(d, 'SConscript'))
Return('objs')
