from building import *
import os

cwd = GetCurrentDir()
src = []
CPPPATH = [cwd]

# STM32F030x6 | STM32F030x8 | STM32F030xC
# STM32F031x6
# STM32F038xx 
# STM32F042x6  
# STM32F048xx  
# STM32F051x8
# STM32F058xx
# STM32F415xG
# STM32F070x6 | STM32F070xB
# STM32F071xB
# STM32F072xB 
# STM32F078xx
# STM32F091xC
# STM32F098xx
CPPDEFINES = ['STM32F072xB']

src = Glob('*.c')
src += Glob('startup_stm32f072xb.s');

group = DefineGroup('stm32f0xx', src, depend = [''], CPPPATH = CPPPATH, CPPDEFINES = CPPDEFINES)
list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))
Return('group')
