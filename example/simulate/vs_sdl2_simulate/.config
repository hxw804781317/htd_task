CONFIG_SOC_SIMULATOR=y
CONFIG_BSP_USING_PC_SIMULATOR=y

#
# HTD-TASK
#
CONFIG_HTD_TASK_ENABLE=y
CONFIG_HTD_TASK_WIN32_SDL2=y
CONFIG_HTD_TASK_THREAD_PRIORITY=28
CONFIG_HTD_TASK_THREAD_STACK_SIZE=4096
CONFIG_HTD_MEMHEAP_FF_ENABLE=y
CONFIG_HTD_MEMHEAP_SRAM_DEV_COUNT=2
# CONFIG_HTD_MEMHEAP_FF_USE_TRACE is not set
# CONFIG_HTD_PRINTF_SUPPORT_FLOAT is not set
# CONFIG_HTD_MEM_USE_BYTELOOP is not set
# CONFIG_HTD_VER_RELEASE is not set
# end of HTD-TASK

#
# components config
#
# CONFIG_HTD_BOOT_ENABLE is not set
CONFIG_HTD_CONSOLE_ENABLE=y
CONFIG_HTD_CONSOLE_NAME="htd"
CONFIG_HTD_CONSOLE_SUPPORT_CMD=y
CONFIG_HTD_CONSOLE_SUPPORT_CMD_HISTORY=y
CONFIG_HTD_CONSOLE_HISTORY_LINES=5
CONFIG_HTD_CONSOLE_CMD_SIZE=48
CONFIG_HTD_CONSOLE_SERIAL_NAME="console"
CONFIG_HTD_CONSOLE_SERIAL_TX_PINNUM=0x09
CONFIG_HTD_CONSOLE_SERIAL_RX_PINNUM=0x0A
CONFIG_HTD_CONSOLE_SERIAL_BAUDRATE=115200
# CONFIG_HTD_BUTTON_ENABLE is not set
# CONFIG_HTD_LED_ENABLE is not set
CONFIG_HTD_FLASH_UTILITY_BOX_ENABLE=y
CONFIG_HTD_FLASH_KV_ENABLE=y
CONFIG_HTD_FLASH_BOX_ENABLE=y
CONFIG_HTD_FLASH_LOG_ENABLE=y
CONFIG_HTD_FLASH_VAR_ENABLE=y
CONFIG_HTD_VFS_ENABLE=y
CONFIG_HTD_VFS_USING_NORFLASH_DEV=y
# CONFIG_HTD_VFS_USING_NANDFLASH_DEV is not set
CONFIG_HTD_VFS_USING_LIB_DHARA=y
# CONFIG_HTD_VFS_USING_SDCARD_DEV is not set
CONFIG_HTD_VFS_USING_POSIX=y
CONFIG_HTD_VFS_FD_MAX=16
# CONFIG_HTD_VFS_USING_ROMFS is not set
CONFIG_HTD_VFS_USING_RAMFS=y
# CONFIG_HTD_VFS_USING_SPIFFS is not set
CONFIG_HTD_VFS_USING_ELM_FATFS=y

#
# elm-chan's FatFs, Generic FAT Filesystem Module
#
CONFIG_VFS_ELM_FATFS_CODE_PAGE=437
CONFIG_VFS_ELM_FATFS_WORD_ACCESS=y
# CONFIG_VFS_ELM_FATFS_USE_LFN_0 is not set
# CONFIG_VFS_ELM_FATFS_USE_LFN_1 is not set
# CONFIG_VFS_ELM_FATFS_USE_LFN_2 is not set
CONFIG_VFS_ELM_FATFS_USE_LFN_3=y
CONFIG_VFS_ELM_FATFS_USE_LFN=3
CONFIG_VFS_ELM_FATFS_MAX_LFN=255
CONFIG_VFS_ELM_FATFS_LFN_UNICODE_0=y
# CONFIG_VFS_ELM_FATFS_LFN_UNICODE_1 is not set
# CONFIG_VFS_ELM_FATFS_LFN_UNICODE_2 is not set
# CONFIG_VFS_ELM_FATFS_LFN_UNICODE_3 is not set
CONFIG_VFS_ELM_FATFS_LFN_UNICODE=0
CONFIG_VFS_ELM_FATFS_DRIVES=1
CONFIG_VFS_ELM_FATFS_REENTRANT=y
# end of elm-chan's FatFs, Generic FAT Filesystem Module

# CONFIG_HTD_VFS_USING_LITTLE_FS is not set
CONFIG_HTD_ELFDL_ENABLE=y
CONFIG_ELFDL_LOAD_IN_SIMULATE=y
# CONFIG_ELFDL_LOAD_IN_RAM is not set
# CONFIG_ELFDL_LOAD_IN_XIP is not set
# end of components config

#
# Hardware Drivers Config
#
# CONFIG_HTD_USING_NANDFLASH is not set
CONFIG_HTD_USING_NORFLASH=y
CONFIG_HTD_NORFLASH_START_ADDR=0x12000000
CONFIG_HTD_NORFLASH_CAPACITY=32
CONFIG_HTD_NORFLASH_BUS_NAME="spim1"
CONFIG_HTD_NORFLASH_POWER_PIN=-1
CONFIG_HTD_NORFLASH_PIN_CS=-1
CONFIG_HTD_NORFLASH_PIN_SCK=-1
CONFIG_HTD_NORFLASH_PIN_MOSI=-1
CONFIG_HTD_NORFLASH_PIN_MISO=-1
# CONFIG_HTD_USING_EEPROM is not set
# end of Hardware Drivers Config

#
# external config
#
# CONFIG_HTD_LIB_USE_EASYTLV is not set
# CONFIG_HTD_LIB_USE_MICRO_ECC is not set
# CONFIG_HTD_LIB_USE_QUICKLZ is not set
# CONFIG_HTD_LIB_USE_FASTLZ is not set
CONFIG_HTD_LIB_USE_SDL2=y
# CONFIG_HTD_LIB_USE_SEGGER_RTT is not set
# CONFIG_HTD_LIB_USE_FREERTOS is not set
# end of external config
