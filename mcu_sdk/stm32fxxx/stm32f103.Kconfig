config BSP_USING_TIMER
    bool 
    default n
config BSP_USING_PWM
    bool 
    default n
config BSP_USING_OCC
    bool 
    default n
menu "On-chip Peripheral Drivers"
    menuconfig BSP_USING_UART
        bool "Enable UART"
        default y
        if BSP_USING_UART
            config BSP_USING_UART1
                bool "Enable UART1"
                default n
            config BSP_UART1_RX_USING_DMA
                bool "Enable UART1 RX DMA"
                depends on BSP_USING_UART1
                default n
            config BSP_UART1_TX_USING_DMA
                bool "Enable UART1 TX DMA"
                depends on BSP_USING_UART1
                default n

            config BSP_USING_UART2
                bool "Enable UART2"
                default n
            config BSP_UART2_RX_USING_DMA
                bool "Enable UART2 RX DMA"
                depends on BSP_USING_UART2
                default n
            config BSP_UART2_TX_USING_DMA
                bool "Enable UART2 TX DMA"
                depends on BSP_USING_UART2
                default n

            config BSP_USING_UART3
                bool "Enable UART3"
                default n
            config BSP_UART3_RX_USING_DMA
                bool "Enable UART3 RX DMA"
                depends on BSP_USING_UART3
                default n
            config BSP_UART3_TX_USING_DMA
                bool "Enable UART3 TX DMA"
                depends on BSP_USING_UART3
                default n
        endif
        
    menuconfig BSP_USING_SPIM
        bool "Enable SPI Master"
        default n
        if BSP_USING_SPIM
            config BSP_USING_SPIM1
                bool "Enable SPI1 Master"
                default n
            config BSP_SPIM1_USING_DMA
                bool "Enable SPI1 Master DMA"
                depends on BSP_USING_SPIM1
                default n
                
            config BSP_USING_SPIM2
                bool "Enable SPI2 Master"
                default n
            config BSP_SPIM2_USING_DMA
                bool "Enable SPI2 Master DMA"
                depends on BSP_USING_SPIM2
                default n

            config BSP_USING_SFW_SPIM1
                bool "Enable Software SPI1 Master"
                default n
            config BSP_USING_SFW_SPIM2
                bool "Enable Software SPI2 Master"
                default n
        endif
        
    menuconfig BSP_USING_I2CM
        bool "Enable I2C Master"
        default n
        if BSP_USING_I2CM
            config BSP_USING_I2CM1
                bool "Enable I2C1 Master"
                default n
            config BSP_USING_I2CM2
                bool "Enable I2C2 Master"
                default n
            
            config BSP_USING_SFW_I2CM1
                bool "Enable Software I2C1 Master"
                default n
            config BSP_USING_SFW_I2CM2
                bool "Enable Software I2C2 Master"
                default n
        endif
    
    menuconfig BSP_USING_SDIO
        bool "Enable SDIO"
        default n
    if BSP_USING_SDIO
        config BSP_USING_SDIO0
            bool "Enable SDIO0"
            default n
        config BSP_SDIO0_USING_DMA
            bool "Enable SDIO0 DMA"
            depends on BSP_USING_SDIO0
            default n
            
        config BSP_USING_SDIO1
            bool "Enable SDIO1"
            default n
        config BSP_SDIO1_USING_DMA
            bool "Enable SDIO1 DMA"
            depends on BSP_USING_SDIO1
            default n   
    endif 

    menuconfig BSP_USING_ADC
        bool "Enable ADC"
        default n
    if BSP_USING_ADC
        config BSP_USING_ADC0
            bool "Enable ADC0"
            default n
        config BSP_USING_ADC1
            bool "Enable ADC1"
            default n
        config BSP_USING_ADC2
            bool "Enable ADC2"
            default n
        config BSP_USING_ADC3
            bool "Enable ADC3"
            default n
        config BSP_USING_ADC4
            bool "Enable ADC4"
            default n
        config BSP_USING_ADC5
            bool "Enable ADC5"
            default n
    endif
    
    menuconfig BSP_USING_RTC
        bool "Enable RTC"
        default y
    
    menuconfig BSP_USING_WDT
        bool "Enable watchdog."
        default y
    if BSP_USING_WDT
        config BSP_WDT_TIMEOUT_MS
            int "set timeout ms(2000~10000)."
            default 3000
    endif
    
    menuconfig BSP_USING_PM
        bool "Enable Power Management"
        default y

    menuconfig BSP_USING_CRC
        bool "Enable Cyclic Redundancy Check(CRC)."
        default y 
        
    menuconfig BSP_USING_USB_DEVICE
        bool "Enable USB-Device"
        default n
    if BSP_USING_USB_DEVICE
        choice
            prompt "Select usb device speed"
            default BSP_USB_DEVICE_SPEED_FS
            config BSP_USB_DEVICE_SPEED_FS
                bool "FS"
            config BSP_USB_DEVICE_SPEED_HS
                bool "HS"
            config BSP_USB_DEVICE_SPEED_AUTO
                bool "AUTO"
        endchoice
        config BSP_USBD_VID
            hex "USB device Vendor-ID"
            default 0x36b7
        config BSP_USBD_PID
            hex "USB device Product-ID"
            default 0xffff
        config BSP_USBD_MENUFATURER_NAME
            string "USB device menufaturer name."
            default "htd"
        config BSP_USBD_PRODUCT_NAME
            string "USB device product name."
            default "usbd-dfu"
        config BSP_USING_USBD_CDC_ACM
            bool "Enable USBD CDC_ACM"
            default n
        config BSP_USING_USBD_CDC_RNDIS
            bool "Enable USBD CDC_RNDIS"
            default n
        config BSP_USING_USBD_CDC_ECM
            bool "Enable USBD CDC_ECM"
            default n
        config BSP_USING_USBD_CDC_NCM
            bool "Enable USBD CDC_NCM"
            default n
        config BSP_USING_USBD_ADB
            bool "Enable USBD ADB"
            default n
        config BSP_USING_USBD_DFU
            bool "Enable USBD DFU"
            default n
        config BSP_USING_USBD_HID
            bool "Enable USBD HID"
            default n
        config BSP_USING_USBD_MSC
            bool "Enable USBD MSC"
            default n
        config BSP_USBD_MSC_DEV_COUNT
            depends on BSP_USING_USBD_MSC
            int "USBD MSC devices count"
            range 1 3
            default 1
        config BSP_USING_USBD_MTP
            bool "Enable USBD MTP"
            default n
        config BSP_USING_USBD_VIDEO
            bool "Enable USBD VIDEO"
            default n
        config BSP_USING_USBD_AUDIO
            bool "Enable USBD AUDIO"
            default n
        config BSP_USING_USBD_VENDOR_PLAYER
            bool "Enable USBD VENDOR_PLAYER"
            default n
        config BSP_USING_USBD_GAMEPAD
            bool "Enable USBD GAMEPAD"
            default n
        config BSP_USING_USBD_MSC_BOOTUF2
            depends on BSP_USING_USBD_MSC
            bool "Enable USBD MSC bootuf2"
            default n
    endif
            
    menuconfig BSP_USING_TIM_PWM_OCC
        bool "Enable TIM/PWM/OCC"
        default n
    if BSP_USING_TIM_PWM_OCC
        config BSP_USING_TIM0
            bool "Enable TIM0"
            default n  
            choice
                depends on BSP_USING_TIM0
                prompt "select TIM0 mode"
                    default BSP_USING_TIM0_MODE_TIM
                config BSP_USING_TIM0_MODE_TIM
                    bool "Timer Mode"
                    select BSP_USING_TIMER
                config BSP_USING_TIM0_MODE_PWM
                    bool "PWM Mode"
                    select BSP_USING_PWM
                config BSP_USING_TIM0_MODE_OCC
                    bool "OCC Mode"
                    select BSP_USING_OCC
            endchoice
            config BSP_TIM0_USING_DMA
                bool "TIM0 using DMA."
                depends on (BSP_USING_TIM0_MODE_PWM || BSP_USING_TIM0_MODE_OCC)
                default n
        config BSP_USING_TIM1
            bool "Enable TIM1"
