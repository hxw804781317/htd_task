import os
from building import *

# get current directory
cwd = GetCurrentDir()
src = [];

src += Glob('./STM32F0xx_HAL_Driver/Src/*.c');
src += Glob('./CMSIS/Device/ST/stm32f0xx/Source/Templates/system_stm32f0xx.c');
path = [cwd + '/CMSIS/Device/ST/stm32f0xx/Include', cwd + '/STM32F0xx_HAL_Driver/Inc'];
path += [cwd + '/CMSIS/Include']

CPPDEFINES = ['USE_HAL_DRIVER', 'USE_FULL_LL_DRIVER']
group = DefineGroup('stm32_sdk', src, depend = ['SOC_SERIES_STM32F0'], CPPPATH = path, CPPDEFINES = CPPDEFINES)
Return('group')
