from building import *
import os

cwd = GetCurrentDir()
src = []
inc = [cwd]

src = Glob('*.c')
group = DefineGroup('stm32_sdk', src, depend = ['SOC_FAMILY_STM32'], CPPPATH = inc)
list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))
Return('group')
