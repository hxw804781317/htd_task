import os
from building import * 

# get current dir path
cwd = GetCurrentDir()

# init src and inc vars
src = []
inc = [cwd]
objs = []

if GetDepend('HTD_SENSOR_USING_9AXIS'):
    src = src + Glob('./*.c')
    objs = DefineGroup('peripherals-9axis', src, depend = [], CPPPATH = inc)
    list = os.listdir(cwd)
    for d in list:
        path = os.path.join(cwd, d)
        if os.path.isfile(os.path.join(path, 'SConscript')):
            objs = objs + SConscript(os.path.join(d, 'SConscript'))
Return('objs')
