# for module compiling
import os
from building import *

# get current dir path
cwd = GetCurrentDir()

list = os.listdir(cwd)
objs = []

# init src and inc vars
src = []
inc = [cwd]

if GetDepend('HTD_EEPROM_USING_SIMULATE'):
    src += Glob('./drv_eeprom_simulator.c');
    
if GetDepend('HTD_EEPROM_USING_AT24CXX'):
    src += Glob('./drv_eeprom_at24cxx.c');

objs = DefineGroup('peripherals', src, depend = ['HTD_USING_EEPROM'], CPPPATH = inc, LOCAL_CCFLAGS = '')             
Return('objs')
