# for module compiling
import os
from building import *

# get current dir path
cwd = GetCurrentDir()

list = os.listdir(cwd)
objs = []

# init src and inc vars
src = []
inc = [cwd]

if GetDepend('HTD_PIXEL_LED_USING_SIMULATE'):
    src += Glob('./drv_pled_simulator.c');

if GetDepend('HTD_PIXEL_LED_USING_WS2812B'):
    src += Glob('./drv_pled_ws2812b.c');

objs = DefineGroup('peripherals', src, depend = ['HTD_USING_PIXEL_LED'], CPPPATH = inc, LOCAL_CCFLAGS = '')             
Return('objs')
