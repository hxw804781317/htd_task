# for module compiling
import os
from building import *

# get current dir path
cwd = GetCurrentDir()
list = os.listdir(cwd)
objs = []

# init src and inc vars
src = []
inc = [cwd]

if GetDepend('HTD_BOOT_ENABLE'):
    src = src + Glob('./src/*.c')
    src = src + Glob('./port/*.c')
    inc += [cwd + '/src']
    inc += [cwd + '/port']
    objs = DefineGroup('htd-boot', src, depend = [''], CPPPATH = inc, LOCAL_CCFLAGS = '')
    for d in list:
        path = os.path.join(cwd, d)
        if os.path.isfile(os.path.join(path, 'SConscript')):
            objs = objs + SConscript(os.path.join(d, 'SConscript'))              
Return('objs')
