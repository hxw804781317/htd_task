menuconfig HTD_CONSOLE_ENABLE
    bool "htd console command enable."
    default y
    if HTD_CONSOLE_ENABLE
        config HTD_CONSOLE_NAME
            string "The console name"
            default "htd"
                    
        config HTD_CONSOLE_SUPPORT_CMD
            bool "support command input."
            default y
        config HTD_CONSOLE_SUPPORT_CMD_HISTORY
            depends on HTD_CONSOLE_SUPPORT_CMD
            bool "support command history"
            default y
        config HTD_CONSOLE_HISTORY_LINES
            depends on HTD_CONSOLE_SUPPORT_CMD_HISTORY
            int "The command history line number"
            range 3 32
            default 5
        config HTD_CONSOLE_CMD_SIZE
            depends on HTD_CONSOLE_SUPPORT_CMD_HISTORY
            int "The command line size for shell"
            range 32 256
            default 48
            
        config HTD_CONSOLE_SERIAL_NAME
            depends on HTD_TASK_ENABLE
            string "Serial name"
            default "uart1"
        config HTD_CONSOLE_SERIAL_TX_PINNUM
            depends on HTD_TASK_ENABLE
            hex "Serial tx pin-number"
            default 0x09
        config HTD_CONSOLE_SERIAL_RX_PINNUM
            depends on HTD_TASK_ENABLE
            hex "Serial rx pin-number"
            default 0x0A
        config HTD_CONSOLE_SERIAL_BAUDRATE
            depends on HTD_TASK_ENABLE
            int "Serial baudrate"
            default 115200
    endif
