import os
from building import *

cwd = GetCurrentDir()
inc = [cwd]
src = []
objs = []

if GetDepend('HTD_VFS_ENABLE'):
    src = src + Glob('./*.c')
    objs = DefineGroup('htd_vfs', src, depend = [''], CPPPATH = inc, LOCAL_CCFLAGS = '')
    list = os.listdir(cwd)
    for d in list:
        path = os.path.join(cwd, d)
        if os.path.isfile(os.path.join(path, 'SConscript')):
            objs = objs + SConscript(os.path.join(d, 'SConscript'))              
Return('objs')

