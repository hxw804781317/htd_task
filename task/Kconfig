menu "HTD-TASK"
    config HTD_TASK_ENABLE
        bool
        default y
    config HTD_TASK_WIN32_SDL2
    	depends on SOC_SIMULATOR
    	bool 
	default y
    choice
        depends on !HTD_TASK_WIN32_SDL2
        prompt "Select RTOS"
        default HTD_TASK_NONOS
        config HTD_TASK_NONOS
            bool "No RTOS"           
        config HTD_TASK_FREERTOS
            bool "FreeRTOS"      
    endchoice
    config HTD_TASK_THREAD_PRIORITY
        depends on !HTD_TASK_NONOS
        int "task thread priority."
        default 28
    config HTD_TASK_THREAD_STACK_SIZE
        depends on !HTD_TASK_NONOS
        int "task thread stack size."
        default 4096
        
    config HTD_MEMHEAP_FF_ENABLE
        bool "memheap ff enable"
        default y
    config HTD_MEMHEAP_SRAM_DEV_COUNT
		depends on HTD_MEMHEAP_FF_ENABLE
        int "memheap ram device count"
        default 2
    config HTD_MEMHEAP_FF_USE_TRACE
        depends on HTD_MEMHEAP_FF_ENABLE
        bool "memheap ff trace enable"
        default n
    
    config LIB_SEGGER_RTT_ENABLE
        bool "segger-rtt lib enable"
        default y
    config HTD_PRINTF_SUPPORT_FLOAT
        bool "printf-fmt support float"
        default n
    config HTD_MEM_USE_BYTELOOP
        bool "memcpy/memset use byte-loop"
        default n
    config HTD_VER_RELEASE
        bool "release version"
        default n
endmenu


