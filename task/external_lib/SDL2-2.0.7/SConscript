# for module compiling
import os
from building import *

# get current dir path
cwd = GetCurrentDir()

list = os.listdir(cwd)
objs = []

# init src and inc vars
src = []
inc = [cwd]

lib = ['SDL2']
lib_path = [cwd]

objs = DefineGroup('SDL2', src, depend = ['HTD_TASK_WIN32_SDL2'], CPPPATH=inc, LIBS=lib, LIBPATH=lib_path)
Return('objs')