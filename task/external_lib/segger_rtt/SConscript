from building import *
import os

cwd = GetCurrentDir()
src = []
inc = [cwd]
group = [];

src += Glob('./SEGGER_RTT.c')
src += Glob('./SEGGER_RTT_printf.c')

if GetDepend('USE_SDK_SEGGER_RTT'):
    Return('group');

group = DefineGroup('htd_task', src, depend = ['LIB_SEGGER_RTT_ENABLE'], CPPPATH = inc)
Return('group')
